include pyproject.toml
include README.md
include LICENSE
include MANIFEST.in

# Rust crate (required for sdist → wheel rebuild on user's machine)
include rust/Cargo.toml
include rust/Cargo.lock
recursive-include rust/src *.rs

# Python source tree (also covered by [tool.maturin] python-source).
recursive-include python/gffbase *.py
include python/gffbase/py.typed

# Tests + fixtures bundled so `pytest` works against an installed sdist.
recursive-include tests *.py
recursive-include tests/data *.gff3 *.gtf

# Project documentation shipped in the sdist.
include CHANGELOG.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include CITATION.cff
include MIGRATION.md

# Excludes — we never want compiled extensions / caches in the sdist.
prune target
prune **/__pycache__
prune **/.pytest_cache
prune **/.mypy_cache
prune **/.ruff_cache
global-exclude *.pyc *.so *.dylib *.dll
